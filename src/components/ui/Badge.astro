---
interface Props {
  tone?: 'dark' | 'light' | 'accent';
  class?: string;
}
const { tone = 'dark', class: className = '' } = Astro.props;
const toneClasses = {
  dark: 'bg-primary-dark/10 text-primary-dark border border-primary-dark/15',
  light: 'bg-white/10 text-white border border-white/15',
  accent: 'bg-accent/10 text-accent border border-accent/20',
};
---
<span class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium ${toneClasses[tone]} ${className}`}>
  <slot />
</span>

---
interface Props {
  question: string;
  open?: boolean;
}
const { question, open = false } = Astro.props;
---
<details class="group border-b border-border py-5" {...(open ? { open: true } : {})}>
  <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-left font-display text-lg font-medium text-primary-dark transition-colors hover:text-accent">
    <span>{question}</span>
    <span class="mt-1 inline-flex h-6 w-6 flex-shrink-0 items-center justify-center transition-transform duration-200 group-open:rotate-45">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
    </span>
  </summary>
  <div class="pt-3 text-base leading-relaxed text-muted max-w-3xl">
    <slot />
  </div>
</details>

---
interface Props {
  value?: number;
  size?: number;
  class?: string;
}
const { value = 5, size = 16, class: className = '' } = Astro.props;
const stars = Array.from({ length: 5 }, (_, i) => i < value);
---
<div class={`inline-flex items-center gap-0.5 ${className}`} role="img" aria-label={`${value} von 5 Sternen`}>
  {stars.map((filled) => (
    <svg width={size} height={size} viewBox="0 0 24 24" fill={filled ? '#C2410C' : 'none'} stroke="#C2410C" stroke-width="1.5" aria-hidden="true">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
    </svg>
  ))}
</div>

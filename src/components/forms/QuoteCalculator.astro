---
import { site } from '~/data/site';

interface Props {
  variant?: 'inline' | 'page';
  id?: string;
}
const { variant = 'inline', id = 'offerte' } = Astro.props;

const services = [
  { value: 'steildach', label: 'Steildach' },
  { value: 'flachdach', label: 'Flachdach' },
  { value: 'metalldach', label: 'Metalldach' },
  { value: 'spenglerei', label: 'Spenglerei' },
  { value: 'solar', label: 'Solaranlage' },
  { value: 'begruenung', label: 'Dachbegrünung' },
  { value: 'wartung', label: 'Wartung' },
  { value: 'notdienst', label: 'Notfall' },
];

const scope = [
  { value: 'sanierung', label: 'Sanierung' },
  { value: 'neubau', label: 'Neubau' },
  { value: 'reparatur', label: 'Reparatur' },
  { value: 'beratung', label: 'Nur Beratung' },
];

const size = [
  { value: 'klein', label: 'bis 80 m²' },
  { value: 'mittel', label: '80-180 m²' },
  { value: 'gross', label: '180-400 m²' },
  { value: 'sehrgross', label: 'über 400 m²' },
  { value: 'unklar', label: 'Weiss nicht' },
];

const timing = [
  { value: 'sofort', label: 'So schnell wie möglich' },
  { value: 'monate3', label: 'In den nächsten 3 Monaten' },
  { value: 'jahr', label: 'Im Lauf des Jahres' },
  { value: 'planung', label: 'Reine Planung' },
];

const propertyType = [
  { value: 'efh', label: 'Einfamilienhaus' },
  { value: 'mfh', label: 'Mehrfamilienhaus' },
  { value: 'gewerbe', label: 'Gewerbe / Industrie' },
  { value: 'oeffentlich', label: 'Öffentlich' },
];
---
<section
  id={id}
  class={`relative ${variant === 'inline' ? '' : 'section-pad bg-bone'}`}
>
  <div class={variant === 'inline' ? '' : 'container-narrow'}>
    <div
      class="overflow-hidden rounded-2xl bg-white shadow-lift"
      data-quote-calc
    >
      <div class="border-b border-border px-6 py-5 md:px-8">
        <div class="flex items-center justify-between gap-4">
          <div class="flex flex-col">
            <h2 class="font-display text-xl font-semibold text-primary-dark md:text-2xl">Offerte berechnen</h2>
            <p class="text-sm text-muted">Kostenlos · unverbindlich · schriftliche Antwort zeitnah</p>
          </div>
          <div class="hidden flex-col items-end text-right md:flex">
            <span class="text-xs uppercase tracking-wide text-muted" data-quote-step-label>Schritt 1 von 5</span>
          </div>
        </div>
        <div class="mt-4 h-1.5 w-full overflow-hidden rounded-full bg-border">
          <div
            class="h-full rounded-full bg-accent transition-all duration-300 ease-out"
            style="width: 20%"
            data-quote-progress
          ></div>
        </div>
      </div>

      <form class="px-6 py-7 md:px-8 md:py-9" data-quote-form novalidate>
        <input type="hidden" name="form-name" value="offerte" />

        <!-- Step 1: Service -->
        <fieldset data-quote-pane data-step="1">
          <legend class="font-display text-lg font-semibold text-primary-dark md:text-xl">Was möchten Sie machen?</legend>
          <p class="mt-1 text-sm text-muted">Wählen Sie die Hauptleistung. Mehrere Punkte? Wählen Sie zuerst die wichtigste, ergänzen können Sie später.</p>
          <div class="mt-5 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
            {services.map((s) => (
              <label class="group flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-border bg-white px-3 py-3 text-sm font-medium text-ink transition-all hover:border-accent hover:bg-accent/5 has-[:checked]:border-accent has-[:checked]:bg-accent has-[:checked]:text-white">
                <input type="radio" name="service" value={s.value} class="sr-only" required />
                <span>{s.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- Step 2: Scope -->
        <fieldset data-quote-pane data-step="2" hidden>
          <legend class="font-display text-lg font-semibold text-primary-dark md:text-xl">Um was geht es konkret?</legend>
          <p class="mt-1 text-sm text-muted">Damit wir die richtige Person für Ihr Anliegen einplanen.</p>
          <div class="mt-5 grid grid-cols-2 gap-2.5">
            {scope.map((s) => (
              <label class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-border bg-white px-4 py-3.5 text-sm font-medium text-ink transition-all hover:border-accent hover:bg-accent/5 has-[:checked]:border-accent has-[:checked]:bg-accent has-[:checked]:text-white">
                <input type="radio" name="scope" value={s.value} class="sr-only" required />
                <span>{s.label}</span>
              </label>
            ))}
          </div>

          <legend class="mt-7 font-display text-base font-semibold text-primary-dark">Wie gross ist die Dachfläche ungefähr?</legend>
          <div class="mt-3 grid grid-cols-2 gap-2.5 sm:grid-cols-5">
            {size.map((s) => (
              <label class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-border bg-white px-3 py-3 text-sm font-medium text-ink transition-all hover:border-accent hover:bg-accent/5 has-[:checked]:border-accent has-[:checked]:bg-accent has-[:checked]:text-white">
                <input type="radio" name="size" value={s.value} class="sr-only" required />
                <span>{s.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- Step 3: Property + Timing -->
        <fieldset data-quote-pane data-step="3" hidden>
          <legend class="font-display text-lg font-semibold text-primary-dark md:text-xl">Welche Art Liegenschaft?</legend>
          <div class="mt-5 grid grid-cols-2 gap-2.5">
            {propertyType.map((p) => (
              <label class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-border bg-white px-4 py-3.5 text-sm font-medium text-ink transition-all hover:border-accent hover:bg-accent/5 has-[:checked]:border-accent has-[:checked]:bg-accent has-[:checked]:text-white">
                <input type="radio" name="propertyType" value={p.value} class="sr-only" required />
                <span>{p.label}</span>
              </label>
            ))}
          </div>

          <legend class="mt-7 font-display text-base font-semibold text-primary-dark">Wann soll es losgehen?</legend>
          <div class="mt-3 grid grid-cols-2 gap-2.5">
            {timing.map((t) => (
              <label class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-border bg-white px-4 py-3.5 text-sm font-medium text-ink transition-all hover:border-accent hover:bg-accent/5 has-[:checked]:border-accent has-[:checked]:bg-accent has-[:checked]:text-white">
                <input type="radio" name="timing" value={t.value} class="sr-only" required />
                <span>{t.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- Step 4: PLZ + Ort -->
        <fieldset data-quote-pane data-step="4" hidden>
          <legend class="font-display text-lg font-semibold text-primary-dark md:text-xl">Wo befindet sich die Liegenschaft?</legend>
          <p class="mt-1 text-sm text-muted">Wir bedienen den gesamten Kanton Zürich.</p>
          <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
            <label class="sm:col-span-1">
              <span class="mb-1.5 block text-sm font-medium text-primary-dark">PLZ</span>
              <input
                type="text"
                name="zip"
                inputmode="numeric"
                pattern="[0-9]{4}"
                maxlength="4"
                required
                class="h-12 w-full rounded-lg border border-border bg-white px-4 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                placeholder="8152"
              />
            </label>
            <label class="sm:col-span-2">
              <span class="mb-1.5 block text-sm font-medium text-primary-dark">Ort</span>
              <input
                type="text"
                name="city"
                required
                class="h-12 w-full rounded-lg border border-border bg-white px-4 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                placeholder="Glattpark"
              />
            </label>
          </div>
          <label class="mt-4 block">
            <span class="mb-1.5 block text-sm font-medium text-primary-dark">Strasse und Hausnummer <span class="font-normal text-muted">(optional)</span></span>
            <input
              type="text"
              name="street"
              class="h-12 w-full rounded-lg border border-border bg-white px-4 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
              placeholder="Vega-Strasse 3"
            />
          </label>
        </fieldset>

        <!-- Step 5: Contact -->
        <fieldset data-quote-pane data-step="5" hidden>
          <legend class="font-display text-lg font-semibold text-primary-dark md:text-xl">Wie erreichen wir Sie?</legend>
          <p class="mt-1 text-sm text-muted">Damit wir für Detailfragen rückfragen können. Kein Verkaufsanruf, versprochen.</p>
          <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <label>
              <span class="mb-1.5 block text-sm font-medium text-primary-dark">Vor- und Nachname</span>
              <input
                type="text"
                name="name"
                required
                autocomplete="name"
                class="h-12 w-full rounded-lg border border-border bg-white px-4 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                placeholder="Anna Beispiel"
              />
            </label>
            <label>
              <span class="mb-1.5 block text-sm font-medium text-primary-dark">Telefon</span>
              <input
                type="tel"
                name="phone"
                required
                autocomplete="tel"
                class="h-12 w-full rounded-lg border border-border bg-white px-4 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                placeholder="079 123 45 67"
              />
            </label>
            <label class="sm:col-span-2">
              <span class="mb-1.5 block text-sm font-medium text-primary-dark">E-Mail <span class="font-normal text-muted">(optional)</span></span>
              <input
                type="email"
                name="email"
                autocomplete="email"
                class="h-12 w-full rounded-lg border border-border bg-white px-4 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                placeholder="anna@beispiel.ch"
              />
            </label>
            <label class="sm:col-span-2">
              <span class="mb-1.5 block text-sm font-medium text-primary-dark">Anmerkung <span class="font-normal text-muted">(optional)</span></span>
              <textarea
                name="message"
                rows="3"
                class="w-full rounded-lg border border-border bg-white px-4 py-3 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                placeholder="Z.B. Schäden nach Sturm, Wunschtermin, Material-Präferenz..."
              ></textarea>
            </label>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-muted">
            Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="underline">Datenschutzerklärung</a> zu. Wir verwenden Ihre Daten ausschliesslich zur Beantwortung Ihrer Anfrage.
          </p>
        </fieldset>

        <!-- Success -->
        <div data-quote-pane data-step="success" hidden class="text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-success/10 text-success">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <h3 class="mt-4 font-display text-2xl font-semibold text-primary-dark">Danke, Ihre Anfrage ist eingegangen.</h3>
          <p class="mt-2 text-base text-muted">
            Wir melden uns zeitnah telefonisch oder per Mail. Bei dringenden Anliegen erreichen Sie uns rund um die Uhr unter <a href={site.contact.phoneHref} class="font-semibold text-accent">{site.contact.phoneFormatted}</a>.
          </p>
        </div>

        <div class="mt-7 flex items-center justify-between gap-3" data-quote-controls>
          <button
            type="button"
            class="inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-sm font-medium text-muted transition-colors hover:text-primary-dark disabled:opacity-40"
            data-quote-prev
            hidden
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"/>
              <polyline points="12 19 5 12 12 5"/>
            </svg>
            Zurück
          </button>
          <button
            type="button"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-base font-medium text-white shadow-soft transition-all hover:-translate-y-px hover:bg-accent-muted hover:shadow-lift"
            data-quote-next
          >
            Weiter
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </button>
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-base font-medium text-white shadow-soft transition-all hover:-translate-y-px hover:bg-accent-muted hover:shadow-lift"
            data-quote-submit
            hidden
          >
            Offerte anfordern
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </button>
        </div>

        <p class="mt-5 text-center text-xs text-muted">
          Lieber telefonieren? <a href={site.contact.phoneHref} class="font-semibold text-primary-dark hover:text-accent">{site.contact.phoneFormatted}</a> · {site.hours.weekdaysShort}
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const init = () => {
    const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
    if (!form) return;
    const wrap = form.closest('[data-quote-calc]') as HTMLElement;
    const progress = wrap.querySelector<HTMLElement>('[data-quote-progress]')!;
    const stepLabel = wrap.querySelector<HTMLElement>('[data-quote-step-label]')!;
    const panes = Array.from(form.querySelectorAll<HTMLElement>('[data-quote-pane]'));
    const prevBtn = form.querySelector<HTMLButtonElement>('[data-quote-prev]')!;
    const nextBtn = form.querySelector<HTMLButtonElement>('[data-quote-next]')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-quote-submit]')!;
    const controls = form.querySelector<HTMLElement>('[data-quote-controls]')!;

    const lastStep = 5;
    let current = 1;

    const render = () => {
      panes.forEach((p) => {
        p.hidden = p.dataset.step !== String(current);
      });
      progress.style.width = `${Math.min(100, (current / lastStep) * 100)}%`;
      stepLabel.textContent = `Schritt ${current} von ${lastStep}`;
      prevBtn.hidden = current <= 1;
      nextBtn.hidden = current >= lastStep;
      submitBtn.hidden = current < lastStep;
    };

    const validateCurrent = () => {
      const pane = panes.find((p) => p.dataset.step === String(current));
      if (!pane) return true;
      const inputs = pane.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input[required], textarea[required]'
      );
      let ok = true;
      inputs.forEach((el) => {
        if (el.type === 'radio') {
          const group = pane.querySelectorAll<HTMLInputElement>(`input[name="${el.name}"]`);
          const checked = Array.from(group).some((g) => g.checked);
          if (!checked) ok = false;
        } else if (!el.value.trim()) {
          ok = false;
          el.classList.add('!border-red-500');
        } else {
          el.classList.remove('!border-red-500');
        }
      });
      if (!ok) {
        pane.animate(
          [{ transform: 'translateX(-6px)' }, { transform: 'translateX(6px)' }, { transform: 'translateX(0)' }],
          { duration: 200 }
        );
      }
      return ok;
    };

    nextBtn.addEventListener('click', () => {
      if (!validateCurrent()) return;
      if (current < lastStep) current++;
      render();
    });

    prevBtn.addEventListener('click', () => {
      if (current > 1) current--;
      render();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateCurrent()) return;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Senden ...';
      const data = new FormData(form);
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
        }).catch(() => {});
      } catch {}
      panes.forEach((p) => (p.hidden = p.dataset.step !== 'success'));
      controls.hidden = true;
      progress.style.width = '100%';
      stepLabel.textContent = 'Fertig';
    });

    form.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.type === 'radio' && current < lastStep) {
        setTimeout(() => {
          if (validateCurrent()) {
            current++;
            render();
          }
        }, 150);
      }
    });

    render();
  };
  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init);
  document.addEventListener('astro:page-load', init);
</script>

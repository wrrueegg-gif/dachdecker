---
import { site } from '~/data/site';
---
<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-primary-dark/95 backdrop-blur-md lg:hidden"
  data-sticky-bar
>
  <div class="grid grid-cols-3 gap-px bg-white/10">
    <a
      href={site.contact.phoneHref}
      class="flex flex-col items-center justify-center gap-1 bg-primary-dark py-3 text-xs font-medium text-white transition-colors hover:bg-primary-mid"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      Anrufen
    </a>
    <a
      href={site.contact.whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center gap-1 bg-primary-dark py-3 text-xs font-medium text-white transition-colors hover:bg-primary-mid"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.6 6.4A8 8 0 0 0 4.7 16.1L4 20l4-1.1a8 8 0 0 0 9.6-12.5zM12 18.4a6.5 6.5 0 0 1-3.3-.9l-.2-.1-2.4.6.6-2.3-.2-.2A6.5 6.5 0 1 1 12 18.4z"/>
      </svg>
      WhatsApp
    </a>
    <a
      href="/#offerte"
      class="flex flex-col items-center justify-center gap-1 bg-accent py-3 text-xs font-medium text-white transition-colors hover:bg-accent-muted"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="2" width="16" height="20" rx="2"/>
        <line x1="8" y1="6" x2="16" y2="6"/>
        <line x1="8" y1="14" x2="16" y2="18"/>
      </svg>
      Offerte
    </a>
  </div>
</div>

<script>
  const init = () => {
    const bar = document.querySelector<HTMLElement>('[data-sticky-bar]');
    if (!bar) return;
    const inputs = document.querySelectorAll<HTMLInputElement>('input, select, textarea');
    inputs.forEach((el) => {
      el.addEventListener('focus', () => {
        bar.style.transform = 'translateY(110%)';
      });
      el.addEventListener('blur', () => {
        bar.style.transform = '';
      });
    });
  };
  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init);
  document.addEventListener('astro:page-load', init);
</script>

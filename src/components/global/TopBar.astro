---
import { site } from '~/data/site';
import Button from '~/components/ui/Button.astro';
---
<header class="sticky top-0 z-40 w-full bg-primary-dark text-white shadow-soft">
  <div class="container-wide flex items-center justify-between gap-4 py-3 md:py-3.5">
    <a href="/" class="flex items-center gap-2.5 group" aria-label="Zur Startseite">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent transition-transform duration-200 group-hover:scale-110">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12 12 4l9 8"/>
          <path d="M5 10v10h14V10"/>
          <path d="M9 20v-6h6v6"/>
        </svg>
      </div>
      <span class="font-display text-lg font-semibold tracking-tight">SADA</span>
      <span class="hidden text-xs font-medium text-white/60 md:inline">Bedachungen seit 1907</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium text-white/85 lg:flex" aria-label="Hauptnavigation">
      <a href="/bedachung" class="transition-colors hover:text-white">Bedachung</a>
      <a href="/spenglerei" class="transition-colors hover:text-white">Spenglerei</a>
      <a href="/solar" class="transition-colors hover:text-white">Solar</a>
      <a href="/wartung" class="transition-colors hover:text-white">Wartung</a>
      <a href="/notdienst" class="transition-colors hover:text-white">Notdienst</a>
      <a href="/referenzen" class="transition-colors hover:text-white">Referenzen</a>
      <a href="/ueber-uns" class="transition-colors hover:text-white">Über uns</a>
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden flex-col items-end text-right md:flex">
        <a
          href={site.contact.phoneHref}
          class="font-display text-lg font-semibold tracking-tight transition-colors hover:text-accent"
        >
          {site.contact.phoneFormatted}
        </a>
        <span class="text-[11px] text-white/55">{site.hours.weekdaysShort} · 24h Notdienst</span>
      </div>
      <Button
        href="/#offerte"
        variant="primary"
        size="sm"
        icon="calculator"
        class="hidden sm:inline-flex"
      >
        Offerte berechnen
      </Button>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-white hover:bg-white/10 lg:hidden"
        aria-label="Menü öffnen"
        data-menu-toggle
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <div
    class="hidden border-t border-white/10 bg-primary-dark lg:hidden"
    data-menu-panel
    hidden
  >
    <div class="container-wide flex flex-col gap-1 py-4">
      <a href="/bedachung" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Bedachung</a>
      <a href="/spenglerei" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Spenglerei</a>
      <a href="/solar" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Solar</a>
      <a href="/dachbegruenung" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Dachbegrünung</a>
      <a href="/wartung" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Wartung</a>
      <a href="/notdienst" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Notdienst</a>
      <a href="/referenzen" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Referenzen</a>
      <a href="/ueber-uns" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Über uns</a>
      <a href="/team" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Team</a>
      <a href="/jobs" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Jobs</a>
      <a href="/kontakt" class="rounded-md px-3 py-2.5 text-base text-white/90 hover:bg-white/5">Kontakt</a>
      <div class="mt-3 flex gap-2 px-2 pb-2">
        <a href={site.contact.phoneHref} class="flex flex-1 items-center justify-center gap-2 rounded-full bg-white/10 px-4 py-2.5 text-sm font-medium text-white">
          Anrufen
        </a>
        <a href="/#offerte" class="flex flex-1 items-center justify-center gap-2 rounded-full bg-accent px-4 py-2.5 text-sm font-medium text-white">
          Offerte
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const init = () => {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    if (!toggle || !panel) return;
    toggle.addEventListener('click', () => {
      const isOpen = !panel.hidden;
      panel.hidden = isOpen;
      panel.classList.toggle('hidden', isOpen);
      panel.classList.toggle('block', !isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  };
  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init);
  document.addEventListener('astro:page-load', init);
</script>

---
import { site } from '~/data/site';
---
<footer class="bg-primary-dark text-white/80">
  <div class="container-wide py-16 md:py-20">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12 12 4l9 8"/>
              <path d="M5 10v10h14V10"/>
              <path d="M9 20v-6h6v6"/>
            </svg>
          </div>
          <span class="font-display text-xl font-semibold text-white">SADA AG</span>
        </a>
        <p class="text-sm leading-relaxed text-white/65">
          Dachdecker, Spengler und Solar-Profis aus Glattpark Opfikon. Im Kanton Zürich seit 1907.
        </p>
        <p class="text-xs text-white/50">
          Teil der <a href="https://www.burkhalter.ch" class="underline-offset-2 hover:underline" target="_blank" rel="noopener noreferrer">Burkhalter Gruppe</a>
        </p>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-white">Leistungen</h3>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          <li><a href="/bedachung" class="text-white/70 hover:text-white">Bedachung</a></li>
          <li><a href="/bedachung/flachdach" class="text-white/70 hover:text-white">Flachdach</a></li>
          <li><a href="/bedachung/steildach" class="text-white/70 hover:text-white">Steildach</a></li>
          <li><a href="/bedachung/metalldach" class="text-white/70 hover:text-white">Metalldach</a></li>
          <li><a href="/spenglerei" class="text-white/70 hover:text-white">Spenglerei</a></li>
          <li><a href="/solar" class="text-white/70 hover:text-white">Solaranlagen</a></li>
          <li><a href="/dachbegruenung" class="text-white/70 hover:text-white">Dachbegrünung</a></li>
          <li><a href="/wartung" class="text-white/70 hover:text-white">Wartung</a></li>
          <li><a href="/notdienst" class="text-white/70 hover:text-white">24h-Notdienst</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-white">Unternehmen</h3>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          <li><a href="/ueber-uns" class="text-white/70 hover:text-white">Über uns</a></li>
          <li><a href="/team" class="text-white/70 hover:text-white">Team</a></li>
          <li><a href="/referenzen" class="text-white/70 hover:text-white">Referenzen</a></li>
          <li><a href="/aktuell" class="text-white/70 hover:text-white">Aktuell</a></li>
          <li><a href="/jobs" class="text-white/70 hover:text-white">Jobs & Karriere</a></li>
          <li><a href="/kontakt" class="text-white/70 hover:text-white">Kontakt</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-white">Kontakt</h3>
        <ul class="mt-4 flex flex-col gap-3 text-sm">
          <li>
            <a href={site.contact.phoneHref} class="font-display text-lg font-semibold text-white hover:text-accent">
              {site.contact.phoneFormatted}
            </a>
            <span class="block text-xs text-white/50">{site.hours.weekdaysShort} · 24h Notdienst</span>
          </li>
          <li>
            <a href={site.contact.emailHref} class="text-white/70 hover:text-white">{site.contact.email}</a>
          </li>
          <li class="text-white/70">
            {site.address.street}<br/>
            {site.address.zip} {site.address.city}
          </li>
          <li>
            <a href={site.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-3 py-1.5 text-xs text-white/85 hover:bg-white/10">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.6 6.4A8 8 0 0 0 4.7 16.1L4 20l4-1.1a8 8 0 0 0 9.6-12.5zM12 18.4a6.5 6.5 0 0 1-3.3-.9l-.2-.1-2.4.6.6-2.3-.2-.2A6.5 6.5 0 1 1 12 18.4z"/>
              </svg>
              WhatsApp
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-wide flex flex-col items-start justify-between gap-3 py-6 text-xs text-white/50 md:flex-row md:items-center">
      <p>© {new Date().getFullYear()} {site.legalName} · Alle Rechte vorbehalten</p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/impressum" class="hover:text-white">Impressum</a>
        <a href="/datenschutz" class="hover:text-white">Datenschutz</a>
        <a href="/agb" class="hover:text-white">AGB</a>
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white">LinkedIn</a>
      </div>
    </div>
  </div>
</footer>

---
import { site } from '~/data/site';
import Button from '~/components/ui/Button.astro';

interface Props {
  eyebrow: string;
  headline: string;
  sub: string;
  bullets?: string[];
  bgImage?: string;
  bgGradient?: 'dark' | 'mid';
}

const {
  eyebrow,
  headline,
  sub,
  bullets = [],
  bgImage,
  bgGradient = 'dark',
} = Astro.props;

const gradients = {
  dark: 'from-primary-dark/92 via-primary-dark/75 to-primary-dark/55',
  mid: 'from-primary-mid/92 via-primary-mid/75 to-primary-mid/55',
};
---
<section class="relative isolate overflow-hidden bg-primary-dark text-white">
  {bgImage && (
    <div class="absolute inset-0 z-0">
      <img
        src={bgImage}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover object-center"
        width="2560"
        height="1440"
      />
      <div class={`absolute inset-0 bg-gradient-to-r ${gradients[bgGradient]}`}></div>
    </div>
  )}

  <div class="container-wide relative z-10 py-20 md:py-28 lg:py-32">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-3 py-1 text-xs font-medium uppercase tracking-wide text-white/85 backdrop-blur-sm">
        {eyebrow}
      </span>
      <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
        {headline}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl">{sub}</p>

      {bullets.length > 0 && (
        <ul class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-white/85">
          {bullets.map((b) => (
            <li class="inline-flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      )}

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <Button href="/#offerte" variant="primary" size="lg" icon="calculator">
          Offerte berechnen
        </Button>
        <Button
          href={site.contact.phoneHref}
          variant="ghost-light"
          size="lg"
          icon="phone"
          class="border border-white/25"
        >
          {site.contact.phoneFormatted}
        </Button>
      </div>
    </div>
  </div>
</section>

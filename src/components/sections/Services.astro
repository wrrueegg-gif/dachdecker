---
import { services } from '~/data/services';
import AnimatedSection from '~/components/ui/AnimatedSection.astro';

const icons: Record<string, string> = {
  home: '<path d="M3 12 12 4l9 8"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/>',
  pipette: '<path d="M6 22h12"/><path d="M9 22V11a3 3 0 0 1 6 0v11"/><path d="M9 17h6"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 4 13c0-6 7-11 18-11 0 8-5 18-11 18Z"/><path d="M2 22c4-4 7-7 13-9"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  alert: '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
};
---
<AnimatedSection class="section-pad bg-white">
  <div class="container-wide">
    <div class="max-w-3xl">
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">Was wir machen</span>
      <h2 class="mt-2 font-display text-3xl font-semibold text-primary-dark md:text-4xl">
        Alles rund ums Dach — aus einer Hand.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted md:text-lg">
        Bedachung, Spenglerei, Solar, Begrünung, Wartung und 24-Stunden-Notdienst. Ein Ansprechpartner für alle Gewerke am Dach, keine Schnittstellen-Diskussionen, keine Koordinationsspielchen.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <a
          href={s.href}
          class="group relative flex flex-col gap-4 overflow-hidden rounded-2xl border border-border bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-accent/30 hover:shadow-lift"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-white">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon] ?? icons.home} />
          </div>
          <div>
            <h3 class="font-display text-xl font-semibold text-primary-dark">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{s.teaser}</p>
          </div>
          <ul class="mt-1 flex flex-col gap-2 text-sm text-ink">
            {s.features.slice(0, 3).map((f) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-accent"></span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <span class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-primary-dark transition-colors group-hover:text-accent">
            Mehr erfahren
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</AnimatedSection>

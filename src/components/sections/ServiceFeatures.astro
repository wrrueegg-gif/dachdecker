---
import AnimatedSection from '~/components/ui/AnimatedSection.astro';

interface Feature {
  title: string;
  text: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  features: Feature[];
}
const { eyebrow = 'Was Sie bekommen', title, intro, features } = Astro.props;
---
<AnimatedSection class="section-pad bg-white">
  <div class="container-wide">
    <div class="max-w-3xl">
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">{eyebrow}</span>
      <h2 class="mt-2 font-display text-3xl font-semibold text-primary-dark md:text-4xl">{title}</h2>
      {intro && <p class="mt-3 text-base leading-relaxed text-muted md:text-lg">{intro}</p>}
    </div>
    <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {features.map((f, i) => (
        <div class="flex flex-col gap-3 rounded-2xl border border-border bg-white p-7 shadow-soft transition-all hover:-translate-y-1 hover:border-accent/30 hover:shadow-lift">
          <span class="font-display text-2xl font-semibold leading-none text-accent" style="font-variant-numeric: tabular-nums;">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="font-display text-lg font-semibold text-primary-dark">{f.title}</h3>
          <p class="text-sm leading-relaxed text-muted">{f.text}</p>
        </div>
      ))}
    </div>
  </div>
</AnimatedSection>

---
import Layout from '~/layouts/Layout.astro';
import { site } from '~/data/site';
import ServiceFeatures from '~/components/sections/ServiceFeatures.astro';
import TrustStrip from '~/components/sections/TrustStrip.astro';
import FAQ from '~/components/sections/FAQ.astro';
import Button from '~/components/ui/Button.astro';

const cases = [
  { title: 'Sturmschaden', text: 'Lose Ziegel, abgehobene Verblechungen, beschädigte Eindeckung nach Sturm.' },
  { title: 'Wasserschaden', text: 'Wasser im Haus, durchnässte Decke, Tropfen in der Wohnung — wir kommen sofort, sichern und dichten provisorisch ab.' },
  { title: 'Hagelschaden', text: 'Durchschläge in Ziegeln, beschädigte PV-Module, Schäden an Lichtkuppeln und Verblechungen.' },
  { title: 'Brandschaden', text: 'Nach Löschwasser-Einsatz: Notabdichtung, Schadensaufnahme für Versicherung, Folgesanierung.' },
];
---
<Layout
  title="24h-Dachnotdienst Zürich — sofort erreichbar | SADA AG"
  description="Sturm, Hagel, Wassereintritt? 24-Stunden-Notdienst für Dachschäden im Kanton Zürich. Sofortmassnahmen vor Ort, schriftliche Reparatur-Offerte folgt."
>
  <section class="relative isolate overflow-hidden bg-primary-dark text-white">
    <div class="container-wide py-20 md:py-28 lg:py-32">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/15 px-3 py-1 text-xs font-medium uppercase tracking-wide text-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
          24 Stunden · 7 Tage
        </span>
        <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
          Dach undicht? Sturmschaden? Rufen Sie jetzt an.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/85 md:text-xl">
          Unser Notdienst ist rund um die Uhr erreichbar. Bei akuten Schäden priorisieren wir und sind schnellstmöglich vor Ort, um den Schaden zu begrenzen.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            href={site.contact.phoneHref}
            class="inline-flex items-center justify-center gap-3 rounded-full bg-accent px-8 py-5 font-display text-2xl font-semibold text-white shadow-lift transition-transform hover:-translate-y-px hover:bg-accent-muted md:text-3xl"
          >
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            {site.contact.phoneFormatted}
          </a>
          <Button
            href={site.contact.whatsappHref}
            variant="ghost-light"
            size="lg"
            icon="whatsapp"
            class="border border-white/25"
            external
          >
            WhatsApp Notfall
          </Button>
        </div>

        <p class="mt-5 text-sm text-white/65">
          Rund um die Uhr besetzt · auch nachts, am Wochenende, an Feiertagen
        </p>
      </div>
    </div>
  </section>

  <TrustStrip />

  <ServiceFeatures
    eyebrow="Wann ein Notfall ein Notfall ist"
    title="Diese Schäden behandeln wir im Notdienst."
    intro="Bei diesen Fällen rufen Sie uns sofort. Nicht warten bis zum nächsten Werktag — Wasser frisst weiter."
    features={cases}
  />

  <section class="section-pad bg-primary-mid text-white">
    <div class="container-wide">
      <div class="max-w-3xl">
        <span class="text-xs font-semibold uppercase tracking-wider text-accent">So läuft der Notfall ab</span>
        <h2 class="mt-2 font-display text-3xl font-semibold md:text-4xl">In vier Schritten zur kontrollierten Situation.</h2>
      </div>
      <ol class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
        <li class="flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.05] p-6">
          <span class="font-display text-4xl font-semibold text-accent">1</span>
          <h3 class="font-display text-lg font-semibold">Sie rufen an</h3>
          <p class="text-sm leading-relaxed text-white/75">Telefon oder WhatsApp. Wir klären in zwei Minuten Lage und Dringlichkeit.</p>
        </li>
        <li class="flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.05] p-6">
          <span class="font-display text-4xl font-semibold text-accent">2</span>
          <h3 class="font-display text-lg font-semibold">Erste Hinweise</h3>
          <p class="text-sm leading-relaxed text-white/75">Was Sie sofort tun (oder lassen) sollten — bevor wir da sind. Schadensbegrenzung beginnt am Telefon.</p>
        </li>
        <li class="flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.05] p-6">
          <span class="font-display text-4xl font-semibold text-accent">3</span>
          <h3 class="font-display text-lg font-semibold">Wir sind vor Ort</h3>
          <p class="text-sm leading-relaxed text-white/75">Wir sichern den Schaden ab, dichten provisorisch und dokumentieren für Ihre Versicherung.</p>
        </li>
        <li class="flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.05] p-6">
          <span class="font-display text-4xl font-semibold text-accent">4</span>
          <h3 class="font-display text-lg font-semibold">Reparatur-Offerte</h3>
          <p class="text-sm leading-relaxed text-white/75">Anschliessend erhalten Sie schriftlich die Offerte für die definitive Reparatur — transparent und nachvollziehbar.</p>
        </li>
      </ol>
    </div>
  </section>

  <FAQ
    title="Häufige Fragen zum Notdienst"
    intro="Was Sie im Notfall wissen müssen — und was nicht."
  />

  <section class="bg-accent text-white">
    <div class="container-wide flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center md:py-16">
      <div class="max-w-2xl">
        <h2 class="font-display text-2xl font-semibold md:text-3xl">Wasser im Haus? Jetzt anrufen — wir sind dran.</h2>
        <p class="mt-2 text-white/90">Nicht warten. Jede Stunde ohne Sicherung kostet mehr Schaden.</p>
      </div>
      <a
        href={site.contact.phoneHref}
        class="inline-flex items-center gap-3 rounded-full bg-white px-8 py-4 font-display text-xl font-semibold text-accent shadow-lift transition-transform hover:-translate-y-px"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        {site.contact.phoneFormatted}
      </a>
    </div>
  </section>
</Layout>

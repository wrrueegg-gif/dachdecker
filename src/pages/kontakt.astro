---
import Layout from '~/layouts/Layout.astro';
import ServiceHero from '~/components/sections/ServiceHero.astro';
import TrustStrip from '~/components/sections/TrustStrip.astro';
import QuoteCalculator from '~/components/forms/QuoteCalculator.astro';
import AnimatedSection from '~/components/ui/AnimatedSection.astro';
import Button from '~/components/ui/Button.astro';
import { site } from '~/data/site';
---
<Layout
  title="Kontakt — SADA AG Glattpark Opfikon"
  description="Kontakt zu SADA AG in Glattpark Opfikon. Telefon, WhatsApp, E-Mail, Anfahrt, Öffnungszeiten."
>
  <ServiceHero
    eyebrow="Kontakt"
    headline="So erreichen Sie uns."
    sub="Telefon, WhatsApp, Mail oder über das Offert-Formular. Auch persönlich am Sitz in Glattpark Opfikon."
  />
  <TrustStrip />

  <AnimatedSection class="section-pad bg-white">
    <div class="container-wide grid grid-cols-1 gap-12 lg:grid-cols-2">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-accent">Kontaktdaten</span>
        <h2 class="mt-2 font-display text-3xl font-semibold text-primary-dark md:text-4xl">
          Direkt, unkompliziert, persönlich.
        </h2>

        <dl class="mt-10 flex flex-col gap-7">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Telefon</dt>
            <dd class="mt-1">
              <a href={site.contact.phoneHref} class="font-display text-2xl font-semibold text-primary-dark hover:text-accent">{site.contact.phoneFormatted}</a>
              <p class="mt-1 text-sm text-muted">{site.hours.weekdaysShort} · 24h-Notdienst rund um die Uhr</p>
            </dd>
          </div>

          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">WhatsApp</dt>
            <dd class="mt-1">
              <a href={site.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-display text-lg font-semibold text-primary-dark hover:text-accent">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.6 6.4A8 8 0 0 0 4.7 16.1L4 20l4-1.1a8 8 0 0 0 9.6-12.5z"/>
                </svg>
                {site.contact.phoneFormatted}
              </a>
            </dd>
          </div>

          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">E-Mail</dt>
            <dd class="mt-1">
              <a href={site.contact.emailHref} class="font-display text-lg font-semibold text-primary-dark hover:text-accent">{site.contact.email}</a>
            </dd>
          </div>

          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Adresse</dt>
            <dd class="mt-1 text-base text-ink">
              {site.legalName}<br/>
              {site.address.street}<br/>
              {site.address.zip} {site.address.city}
            </dd>
            <dd class="mt-3">
              <a href={site.address.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline">
                Anfahrt planen
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="7" y1="17" x2="17" y2="7"/>
                  <polyline points="7 7 17 7 17 17"/>
                </svg>
              </a>
            </dd>
          </div>

          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Service-Region</dt>
            <dd class="mt-1 text-base text-ink">{site.serviceRegion}</dd>
          </div>
        </dl>
      </div>

      <div>
        <QuoteCalculator id="offerte-kontakt" />
      </div>
    </div>
  </AnimatedSection>

  <AnimatedSection class="bg-bone py-16 md:py-20">
    <div class="container-wide">
      <h2 class="font-display text-2xl font-semibold text-primary-dark md:text-3xl">Anfahrt nach Glattpark</h2>
      <p class="mt-2 text-base text-muted">Mit ÖV: S-Bahn bis Glattbrugg oder Tram bis Glattpark. Mit Auto: A1 Abfahrt Opfikon.</p>
      <div class="mt-6 aspect-[16/9] w-full overflow-hidden rounded-2xl border border-border bg-white">
        <iframe
          title="Karte SADA AG"
          src="https://www.openstreetmap.org/export/embed.html?bbox=8.564%2C47.418%2C8.580%2C47.428&layer=mapnik&marker=47.4234%2C8.5722"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="h-full w-full"
        ></iframe>
      </div>
    </div>
  </AnimatedSection>
</Layout>

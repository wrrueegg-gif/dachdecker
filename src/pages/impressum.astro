---
import Layout from '~/layouts/Layout.astro';
import { site } from '~/data/site';
---
<Layout
  title="Impressum — SADA AG"
  description="Impressum SADA AG Glattpark Opfikon"
  noIndex
>
  <section class="section-pad">
    <div class="container-narrow">
      <h1 class="font-display text-4xl font-semibold text-primary-dark">Impressum</h1>
      <p class="mt-4 text-base text-muted">Vom Inhaber zu vervollständigen. Untenstehende Angaben sind Platzhalter.</p>

      <dl class="mt-10 flex flex-col gap-6">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Verantwortlich für den Inhalt</dt>
          <dd class="mt-1 text-base text-ink">
            {site.legalName}<br/>
            {site.address.street}<br/>
            {site.address.zip} {site.address.city}<br/>
            Schweiz
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Kontakt</dt>
          <dd class="mt-1 text-base text-ink">
            Telefon: <a href={site.contact.phoneHref} class="text-accent hover:underline">{site.contact.phoneFormatted}</a><br/>
            E-Mail: <a href={site.contact.emailHref} class="text-accent hover:underline">{site.contact.email}</a>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Handelsregister</dt>
          <dd class="mt-1 text-base text-ink">[UID / Handelsregister-Eintrag vom Inhaber ergänzen]</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Haftungsausschluss</dt>
          <dd class="mt-1 text-base leading-relaxed text-ink">[Standardtext vom Inhaber ergänzen — Haftung für Inhalte, Links, Urheberrecht]</dd>
        </div>
      </dl>
    </div>
  </section>
</Layout>

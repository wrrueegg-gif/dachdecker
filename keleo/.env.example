# Lokale Entwicklung: Datei nach .env kopieren und Werte anpassen.
# Auf Vercel werden dieselben Namen unter Project Settings → Environment Variables gesetzt.
APP_PASSWORD=keleo
SESSION_SECRET=bitte-durch-eine-lange-zufaellige-zeichenkette-ersetzen
# Ohne DATABASE_URL wird lokal eine PGlite-Datenbank im Ordner .data/ verwendet.
# DATABASE_URL=postgresql://keleo_app.<projekt-ref>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Optional, für den E-Mail-Versand über Resend (https://resend.com):
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="Meine Firma <rechnungen@meine-domain.ch>"

{
  "name": "keleo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keleo – kleines Rechnungs- und Offertenprogramm mit Schweizer QR-Rechnung, läuft auf Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply keleo --local",
    "db:migrate:remote": "wrangler d1 migrations apply keleo --remote",
    "db:create": "wrangler d1 create keleo",
    "cf-typegen": "wrangler types",
    "cloud:setup": "node scripts/cloud-setup.mjs"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}

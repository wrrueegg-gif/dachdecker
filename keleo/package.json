{
  "name": "keleo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keleo – kleines Rechnungs- und Offertenprogramm mit Schweizer QR-Rechnung, läuft auf Vercel mit Postgres (Supabase)",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "start": "tsx src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keleo",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Statische Dateien (CSS, JS) werden direkt vom Cloudflare-Edge ausgeliefert,
  // alles andere geht an den Worker (Hono-App).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // Cloudflare D1 = serverlose SQLite-Datenbank.
  // Nach `npm run db:create` die ausgegebene database_id hier eintragen.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keleo",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Nicht-geheime Konfiguration. Geheimnisse (APP_PASSWORD, SESSION_SECRET,
  // RESEND_API_KEY) werden mit `wrangler secret put NAME` gesetzt – nie hier eintragen.
  "vars": {
    "APP_NAME": "Keleo",
    "SESSION_DAYS": "30"
  }
}
